# =====================================================
# CAMPUSMIND AI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values
# DO NOT COMMIT YOUR REAL .env FILE TO GITHUB!
# =====================================================

# 1. APPLICATION & JWT SECURITY
SECRET_KEY=your-super-secret-random-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# 2. OPENROUTER AI CONFIGURATION
# Sign up and get your free API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=CampusMind AI
OPENROUTER_TIMEOUT=15

# 3. SUPABASE (OPTIONAL CLOUD AUTH SYNC)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# 4. MYSQL (OPTIONAL LOCAL DATABASE - SQLite is used by default)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=campusmind_ai

# 5. ELEVENLABS (JARVIS 3D ANIMATED VOICE ASSISTANT)
# Free account at https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
