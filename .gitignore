# =====================================================
# CAMPUSMIND AI - GITIGNORE
# Strict security & privacy rules
# =====================================================

# 1. ENVIRONMENT VARIABLES & SECRETS (STRICT SECURITY)
.env
.env.*
*.env
bakend/.env
!.env.example
!bakend/.env.example
*.key
*.pem
*.cert

# 2. PYTHON BYTECODE & CACHE
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# 3. VIRTUAL ENVIRONMENTS
venv/
env/
.venv/
ENV/

# 4. LOCAL DATABASES & RUNTIME STORAGE
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
bakend/campusmind.db
bakend/campusmind.db*
uploads/
bakend/uploads/
!bakend/uploads/.gitkeep

# 5. IDE & OS METADATA
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# 6. LOGS & SCRATCH
*.log
scratch/
