SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=campusmind_ai

